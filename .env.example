# ── Supabase (optional — leave unset to use the localStorage demo mode) ──────
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL editor
# 3. Copy these two values from Project Settings → API, then restart the app.
#    Set the same two vars in Vercel → Project → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
