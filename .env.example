# ── Supabase ─────────────────────────────────────────────────────────────────
# Leave both unset → the site runs in localStorage demo mode (no login,
# reservations stored on-device). Set both → real database + sign-in.
#
# Where to find the values: Supabase dashboard → Project Settings → API
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon public" key  (NEVER the service_role key)
#
# Local dev:  copy this file to .env.local and paste the values.
# Production: add the same two variables in Vercel → Settings → Environment Variables.
#
# One-time database setup: run supabase/schema.sql in the Supabase SQL editor.
# Auth providers (Google / Apple) are configured in the Supabase dashboard:
# Authentication → Providers. Also set Authentication → URL Configuration →
# Site URL to the production domain and add http://localhost:3000 as a
# redirect URL for local dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
