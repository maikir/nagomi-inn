# Configuration template — safe to commit; keep credentials empty.
# Copy to .env.local for local use. Set deployment values in Vercel.

# ── Supabase ──
# Run supabase/schema.sql for initial database setup.
# Public values: Supabase dashboard → Project Settings → API.
# Leave both public values empty to use browser-only demo mode.
# SUPABASE_SERVICE_ROLE_KEY is private and server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments (Stripe) ──
# Run supabase/stripe-ical-migration.sql before enabling payments.
# NEXT_PUBLIC_PAYMENTS=stripe enables Checkout; rebuild after changing it.
# Use Stripe test keys for testing. Stripe secret keys are server-only.
# Webhook: https://<this-environment-domain>/api/stripe-webhook
# Events: checkout.session.completed, checkout.session.expired,
#         checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed
# Refund events: refund.created, refund.updated, refund.failed
# The webhook signing secret must match this environment's endpoint.
# For local Stripe CLI testing, use the secret printed by stripe listen.
NEXT_PUBLIC_PAYMENTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Owner dashboard (/admin) ──
# Comma-separated account emails allowed to use the owner dashboard.
# Example: owner@example.com,manager@example.com
ADMIN_EMAILS=

# ── Reservation confirmation emails (Resend) ──
# Run supabase/reservation-emails.sql before enabling emails.
# Also run supabase/cancellation-emails.sql for cancellation/refund notifications.
# Verify nagomi-inn-miyazaki.com in Resend and set this environment's API key.
# Set RESERVATION_EMAILS_ENABLED=true when configuration is ready.
# Email settings are server-only: never add a NEXT_PUBLIC_ prefix.
# FROM uses the verified domain; guest replies go to the Gmail inbox.
# HOTEL_ADDRESS is temporary: replace it with the real address when ready.
# Stripe test-mode bookings also send real emails when enabled.
RESERVATION_EMAILS_ENABLED=false
RESEND_API_KEY=
RESERVATION_EMAIL_FROM="Nagomi Inn <reservations@nagomi-inn-miyazaki.com>"
WELCOME_EMAIL_FROM="Gen and Sarah from Nagomi Inn <hello@nagomi-inn-miyazaki.com>"
RESERVATION_EMAIL_REPLY_TO=nagomi.inn.miyazaki@gmail.com
HOTEL_ADDRESS="仮住所：宮崎県（詳細住所は後日ご案内） / Temporary address: Miyazaki Prefecture, Japan. Exact address to follow."

# ── OTA calendar sync (Airbnb / Booking.com) ──
# Export URL (replace placeholders locally; do not save tokens in comments):
# https://<this-environment-domain>/api/calendar.ics?token=<ICAL_EXPORT_TOKEN>
# Use a long random value for ICAL_EXPORT_TOKEN and CRON_SECRET.
# ICAL_IMPORT_URLS: comma-separated source=url pairs from OTA export feeds.
# Example: airbnb=https://.../calendar.ics,booking=https://.../calendar.ics
# CRON_SECRET protects /api/ical-sync; Vercel Cron sends it automatically.
ICAL_EXPORT_TOKEN=
ICAL_IMPORT_URLS=
CRON_SECRET=
