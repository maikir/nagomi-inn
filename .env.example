# ── Supabase ─────────────────────────────────────────────────────────────────
# Leave both unset → the site runs in localStorage demo mode (no login,
# reservations stored on-device). Set both → real database + sign-in.
#
# Where to find the values: Supabase dashboard → Project Settings → API
#   NEXT_PUBLIC_SUPABASE_URL      = "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = "anon public" key  (NEVER the service_role key)
#
# Local dev:  copy this file to .env.local and paste the values.
# Production: add the same two variables in Vercel → Settings → Environment Variables.
#
# One-time database setup: run supabase/schema.sql in the Supabase SQL editor.
# Auth providers (Google / Apple) are configured in the Supabase dashboard:
# Authentication → Providers. Also set Authentication → URL Configuration →
# Site URL to the production domain and add http://localhost:3000 as a
# redirect URL for local dev.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Payments (Stripe) ────────────────────────────────────────────────────────
# Before enabling: run supabase/stripe-ical-migration.sql in the SQL editor.
# Then set all four below and NEXT_PUBLIC_PAYMENTS=stripe (build-time flag —
# redeploy after changing it). Server-only keys: never expose to the browser.
#   STRIPE_SECRET_KEY         Stripe dashboard → Developers → API keys (sk_test_… first)
#   STRIPE_WEBHOOK_SECRET     Stripe dashboard → Webhooks → your endpoint → signing secret
#                             endpoint URL: https://<domain>/api/stripe-webhook
#                             events: checkout.session.completed, checkout.session.expired
#   SUPABASE_SERVICE_ROLE_KEY Supabase → Project Settings → API → service_role
NEXT_PUBLIC_PAYMENTS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ── OTA calendar sync (Airbnb / Booking.com, iCal) ───────────────────────────
# Export feed (paste into the OTA "import calendar" box):
#   https://<domain>/api/calendar.ics?token=<ICAL_EXPORT_TOKEN>
#   Pick any long random string as the token (e.g. `openssl rand -hex 24`).
# Import feeds (the OTAs' "export calendar" links), comma-separated source=url:
#   ICAL_IMPORT_URLS="airbnb=https://www.airbnb.com/calendar/ical/XXXX.ics?s=YYYY,booking=https://admin.booking.com/hotel/hoteladmin/ical.html?t=ZZZZ"
# CRON_SECRET protects /api/ical-sync (Vercel Cron sends it automatically).
ICAL_EXPORT_TOKEN=
ICAL_IMPORT_URLS=
CRON_SECRET=
